# ─────────────────────────────────────────────
# FlowMind Backend — Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB
MONGODB_URL=mongodb://localhost:27017
DB_NAME=flowmind

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Google OAuth
# Get this from: https://console.cloud.google.com/
# Create OAuth 2.0 Client ID → Web application
# Add "http://localhost:5173" to Authorized JS origins
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# MCP Layer (set when your MCP service is running)
# If MCP_LAYER_URL is empty or unreachable, backend uses mock responses
MCP_LAYER_URL=http://localhost:9000
MCP_DEV_MOCK=true

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Redis (optional — only needed for multi-instance WS broadcasting)
# REDIS_URL=redis://localhost:6379
